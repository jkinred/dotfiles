# =============================================================
# Theme (Catppuccin)
# =============================================================

theme = dark:Catppuccin Mocha,light:Catppuccin Latte
gtk-custom-css = tab-style.css
window-theme = ghostty
maximize = true
# window-show-tab-bar = always
window-new-tab-position = end
window-subtitle = false
unfocused-split-opacity = 0.6
cursor-style = block
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m
shell-integration-features = ssh-terminfo
# background-opacity = 0.9
# gtk-toolbar-style = flat

# =============================================================
# General Options
# =============================================================

scrollback-limit = 104857600
font-size = 18
# Claude Code multi-line input
keybind = shift+enter=text:\x1b\x0d
bell-features=border
gtk-titlebar-hide-when-maximized=true
# gtk-toolbar-style=flat
# gtk-wide-tabs = false
gtk-tabs-location = bottom

mouse-hide-while-typing = true
# focus-follows-mouse = true
mouse-scroll-multiplier = 3

# Inherit the working directory when creating new splits/tabs.
split-inherit-working-directory = true
tab-inherit-working-directory = false
shell-integration = detect
shell-integration-features = no-cursor,sudo,title

# Ensure Ctrl+Space itself doesn't get sent to the terminal.
# Double-tap to send a literal Ctrl+Space if needed.
# keybind = ctrl+space>ctrl+space=text:\x00

# =============================================================
# Split Management
# =============================================================

keybind = ctrl+space>shift+five=new_split:right
keybind = ctrl+space>shift+apostrophe=new_split:down
keybind = ctrl+space>x=close_surface
keybind = ctrl+space>z=toggle_split_zoom
keybind = ctrl+space>shift+e=equalize_splits

# =============================================================
# Split Navigation (Vi-style)
# =============================================================

keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right

# =============================================================
# Split Resizing
# =============================================================

keybind = ctrl+space>alt+h=resize_split:left,100
keybind = ctrl+space>alt+j=resize_split:down,100
keybind = ctrl+space>alt+k=resize_split:up,100
keybind = ctrl+space>alt+l=resize_split:right,100

# =============================================================
# Window / Tab Management
# =============================================================

keybind = ctrl+space>c=new_tab

# Ghostty has no "toggle to last tab" action. The closest

# Navigate tabs.
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab

# Go to tab by number.
keybind = ctrl+space>one=goto_tab:1
keybind = ctrl+space>two=goto_tab:2
keybind = ctrl+space>three=goto_tab:3
keybind = ctrl+space>four=goto_tab:4
keybind = ctrl+space>five=goto_tab:5
keybind = ctrl+space>six=goto_tab:6
keybind = ctrl+space>seven=goto_tab:7
keybind = ctrl+space>eight=goto_tab:8
keybind = ctrl+space>nine=goto_tab:9

# Rename tab title.
keybind = ctrl+space>comma=prompt_surface_title

# =============================================================
# Scrollback Search
# =============================================================

keybind = ctrl+space>shift+slash=start_search
keybind = ctrl+space>ctrl+n=navigate_search:next
keybind = ctrl+space>ctrl+p=navigate_search:previous

# =============================================================
# Miscellaneous
# =============================================================

keybind = ctrl+space>r=reload_config
keybind = ctrl+space>shift+semicolon=toggle_command_palette
keybind = global:super+shift+backquote=toggle_quick_terminal
quick-terminal-size=100%,100%
quick-terminal-position=bottom
quick-terminal-screen=mouse
